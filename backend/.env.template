# Database Configuration
DATABASE_URL=postgresql://user:password@localhost/snn_ai_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OAuth Configuration (for Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Frontend URL for redirects
FRONTEND_URL=http://localhost:5173

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173

# File Upload Settings
MAX_UPLOAD_SIZE=200  # in MB
UPLOAD_DIR=uploads
ANALYSIS_STORE=results/analysis

# Environment
ENVIRONMENT=development
DEBUG=True
# ---------------------------------------------------------------------------
# DEAP Dataset (EEG Research Pipeline)
# ---------------------------------------------------------------------------
# Set this to the absolute path of the directory containing DEAP .dat files.
# The DEAP dataset must be supplied locally by the researcher.
# It is never downloaded automatically and must never be committed to Git.
# Example:
#   DEAP_DATA_DIR=/Users/yourname/Datasets/DEAP
DEAP_DATA_DIR=
